# Laravel-specific ignores
vendor/
storage/
bootstrap/cache/
public/storage/

# Environment
.env
.env.local
.env.*

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled and build artifacts
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out

# Logs and temp files
*.log
*.tmp
*.swp
*.swo

# Cache directories
.cache/
.php_cs.cache
.ide-helper.meta
_ide_helper.php

# OS generated files
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Testing
.phpunit.result.cache
```

